# Code signing
*.p12
*.mobileprovision

# Sparkle EdDSA keys — never commit private keys
*.pem
EdDSA*

# Instruments
*.trace

# Model files — large binary files, not committed to git
# Bundled models must be managed separately (see docs/DECISIONS.md DEC-2)
Voxema/Resources/Models/*
!Voxema/Resources/Models/.gitkeep
!Voxema/Resources/Models/models-manifest.json
*.gguf
*.onnx
*.mlmodel
*.mlpackage
*.mlmodelc
*.bin

